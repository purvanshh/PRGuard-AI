DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
REDIS_URL=redis://redis-data:6379/0
REDIS_FALLBACK_TO_MEMORY=false

# Semgrep SAST integration
PRGUARD_FLAG_SEMGREP_INTEGRATION=false
PRGUARD_FLAG_SEMGREP_INTEGRATION_ROLLOUT_PERCENT=0
SEMGREP_BINARY=semgrep
SEMGREP_CONFIGS=p/owasp-top-ten
SEMGREP_TIMEOUT_SECONDS=90
SEMGREP_MAX_TARGET_BYTES=2000000
SEMGREP_BASELINE_REF=origin/main
SEMGREP_PERSIST_LOGS=true

# Semgrep stretch features (opt-in)
PRGUARD_FLAG_SEMGREP_AUTOFIX=false
