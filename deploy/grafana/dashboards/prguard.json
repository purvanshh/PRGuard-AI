{
  "title": "PRGuard AI Operations",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "p95 Review Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(prguard_review_latency_seconds_bucket[5m])) by (le))"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Queue Depth",
      "targets": [{"expr": "prguard_queue_depth"}],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Agent Errors",
      "targets": [{"expr": "sum by (agent) (rate(prguard_agent_errors_total[5m]))"}],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "type": "stat",
      "title": "Circuit Breaker State",
      "targets": [{"expr": "max(prguard_circuit_breaker_state)"}],
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "LLM Tokens By Model",
      "targets": [{"expr": "sum by (model) (rate(prguard_llm_tokens_total[5m]))"}],
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8}
    }
  ]
}
